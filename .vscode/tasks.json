{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:web",
      "type": "shell",
      "command": "pnpm --filter @parksplash/web dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "web",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "dev:api",
      "type": "shell",
      "command": "pnpm --filter @parksplash/cms dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "api",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "dev:all",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "split",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "verify",
      "type": "shell",
      "command": "pnpm run verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "checks",
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
